# ─────────────────────────────────────────────────────────────
#  FÉNIX POINT · variables de entorno
#  Copia este archivo a .env.local (local) y cárgalas en Vercel
#  (Project → Settings → Environment Variables). NUNCA subas .env.local a git.
# ─────────────────────────────────────────────────────────────

# Base de datos NUEVA y propia de Fénix Point (Aiven for PostgreSQL), no la de otros sistemas.
# Formato: postgres://avnadmin:PASSWORD@HOST:PUERTO/fenixpoint?sslmode=require
DATABASE_URL=

# Certificado CA de Aiven. En Vercel pega el PEM en una sola línea (saltos de línea como \n).
DATABASE_CA_CERT=
# En local puedes guardarlo en certs/aiven-ca.pem
DATABASE_CA_CERT_PATH=certs/aiven-ca.pem

# Solo para PostgreSQL LOCAL de desarrollo (sin SSL). Se ignora en producción.
# DATABASE_SSL=off

# Firma de sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL pública del sitio (la del QR, sin / final). Se usa para el QR imprimible.
NEXT_PUBLIC_SITE_URL=https://fenixpoint-ayora.vercel.app
